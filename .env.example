# Copy this file to .env and uncomment only values you want to override.
# The application runs with application.properties defaults when .env is absent.

# File storage
# FILORAFS_STORAGE_PATH=./uploads

# API key - ALWAYS override for deployed environments
# FILORAFS_API_KEY=replace_with_a_secure_api_key

# Multipart limits
# FILORAFS_MAX_FILE_SIZE=10MB
# FILORAFS_MAX_REQUEST_SIZE=10MB

# Graceful shutdown
# SHUTDOWN_TIMEOUT=30s
