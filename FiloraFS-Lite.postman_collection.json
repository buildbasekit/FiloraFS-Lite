{
  "info": {
    "_postman_id": "a4cec336-a594-4507-a5f2-3eaf741fefcd",
    "name": "BuildBaseKit · FiloraFS-Lite v2",
    "version": "2.0.0",
    "description": "FiloraFS-Lite v2 by BuildBaseKit — a lightweight local filesystem foundation on Spring Boot 4.1.1 and Java 25 LTS.\n\nStart the application with the Maven wrapper; no .env file is required. Use http://localhost:8080/api-test for the branded browser console, or choose a supported file in Upload File and run this collection in order: upload → list → metadata → download → delete. Upload captures the generated stored filename automatically.\n\nThe /file routes and X-API-KEY contract are unchanged. The included API key is for local development only; override apiKey when testing a deployed environment.\n\n[Website](https://buildbasekit.com/boilerplates/filora-fs-lite/) · [Documentation](https://buildbasekit.com/docs/filorafs-lite/overview/)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Upload File",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set(\"filename\", pm.response.text().trim());",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Choose a PNG, JPEG, PDF, or WebP file."
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/file",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "file"
          ]
        },
        "description": "Uploads multipart field `file` and returns a UUID-based stored filename. The test script saves it as `filename`."
      },
      "response": []
    },
    {
      "name": "List Files",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/file/list",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "file",
            "list"
          ]
        },
        "description": "Returns a sorted JSON array of stored filenames."
      },
      "response": []
    },
    {
      "name": "Get File Metadata",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/file/info/{{filename}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "file",
            "info",
            "{{filename}}"
          ]
        },
        "description": "Returns the stored name, size in KB, filename-derived media type, and last-modified timestamp."
      },
      "response": []
    },
    {
      "name": "Download File",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/file/{{filename}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "file",
            "{{filename}}"
          ]
        },
        "description": "Streams the stored file as a Spring Resource with attachment headers. Use Postman's Save Response to save the bytes."
      },
      "response": []
    },
    {
      "name": "Delete File",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-API-KEY",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/file/{{filename}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "file",
            "{{filename}}"
          ]
        },
        "description": "Deletes the stored file. Returns `true` when deleted and `false` when it was already missing."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "filorafs-local-dev-key",
      "type": "string"
    },
    {
      "key": "filename",
      "value": "",
      "type": "string"
    }
  ]
}
